{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "available": {
      "type": "boolean"
    },
    "unavailableReason": {
      "type": "string"
    },
    "connection": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "profileId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "label": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "connected",
                "identity-only",
                "signed-out",
                "reauthorization-required",
                "verification-pending"
              ]
            },
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "catalogRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "models": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "inputModalities": {
                    "maxItems": 128,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "contextWindow": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "contextWindowSource": {
                    "type": "string",
                    "enum": [
                      "official-model-reference",
                      "local-planning-fallback",
                      "subscription-catalog"
                    ]
                  },
                  "reasoningLevels": {
                    "maxItems": 128,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "capabilities": {
                    "type": "object",
                    "properties": {
                      "serviceTiers": {
                        "maxItems": 32,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "description": {
                              "type": "string",
                              "maxLength": 4096
                            }
                          },
                          "required": [
                            "id"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "additionalSpeedTiers": {
                        "maxItems": 128,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "defaultReasoningLevel": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "supportedReasoningLevels": {
                        "maxItems": 32,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "effort": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "description": {
                              "type": "string",
                              "maxLength": 4096
                            }
                          },
                          "required": [
                            "effort"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "defaultReasoningSummary": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "contextWindow": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 100000000
                      },
                      "maxContextWindow": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 100000000
                      },
                      "effectiveContextWindowPercent": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "inputModalities": {
                        "maxItems": 128,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "supportsImageDetailOriginal": {
                        "type": "boolean"
                      },
                      "supportsSearchTool": {
                        "type": "boolean"
                      },
                      "webSearchToolType": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "applyPatchToolType": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "experimentalSupportedTools": {
                        "maxItems": 128,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "shellType": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "toolMode": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "useResponsesLite": {
                        "type": "boolean"
                      },
                      "nodeReplDisabled": {
                        "type": "boolean"
                      },
                      "nodeReplAutoReviewRequired": {
                        "type": "boolean"
                      },
                      "multiAgentVersion": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "multiAgentReasoningEffort": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "supportVerbosity": {
                        "type": "boolean"
                      },
                      "defaultVerbosity": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "supportsReasoningEffortUpdates": {
                        "type": "boolean"
                      },
                      "supportsExperimentalContext": {
                        "type": "boolean"
                      },
                      "supportedInApi": {
                        "type": "boolean"
                      },
                      "availableAccessPrograms": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "additionalProperties": {}
                      },
                      "truncationPolicy": {
                        "type": "object",
                        "properties": {
                          "mode": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "limit": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "mode",
                          "limit"
                        ],
                        "additionalProperties": false
                      },
                      "description": {
                        "type": "string",
                        "maxLength": 4096
                      },
                      "priority": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "availabilityNux": {},
                      "upgrade": {}
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "slug",
                  "displayName"
                ],
                "additionalProperties": false
              }
            },
            "catalogState": {
              "type": "string",
              "enum": [
                "empty",
                "fresh",
                "cached",
                "failed"
              ]
            },
            "catalogError": {
              "type": "string"
            },
            "remoteRevocation": {
              "type": "string",
              "enum": [
                "confirmed",
                "unconfirmed"
              ]
            },
            "usageAcknowledged": {
              "type": "boolean"
            }
          },
          "required": [
            "profileId",
            "label",
            "status",
            "generation",
            "scopes",
            "catalogRevision",
            "models",
            "catalogState",
            "usageAcknowledged"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "pending": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "attemptId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "kind": {
              "type": "string",
              "enum": [
                "sign-in",
                "switch",
                "reauthorize"
              ]
            }
          },
          "required": [
            "attemptId",
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "revision",
    "available",
    "connection",
    "pending"
  ],
  "additionalProperties": false
}
