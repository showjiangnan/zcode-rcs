{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "registered"
        },
        "deviceId": {
          "type": "string"
        },
        "incarnation": {
          "type": "string"
        },
        "serverInstanceId": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "deviceId",
        "incarnation",
        "serverInstanceId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pong"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hosts"
        },
        "requestId": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "type",
        "requestId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "attach"
        },
        "requestId": {
          "type": "string",
          "maxLength": 128
        },
        "attachmentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "hostId": {
          "type": "string",
          "maxLength": 128
        },
        "hostGeneration": {
          "type": "string",
          "maxLength": 128
        },
        "workspaceHandle": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "type",
        "requestId",
        "attachmentId",
        "hostId",
        "hostGeneration",
        "workspaceHandle"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "activate"
        },
        "attachmentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "type",
        "attachmentId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "detach"
        },
        "attachmentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "type",
        "attachmentId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "flow"
        },
        "attachmentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "state": {
          "type": "string",
          "enum": [
            "saturated",
            "drained"
          ]
        }
      },
      "required": [
        "type",
        "attachmentId",
        "state"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "resource"
        },
        "requestId": {
          "type": "string",
          "maxLength": 128
        },
        "attachmentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "operation": {
          "type": "string",
          "enum": [
            "stat",
            "read"
          ]
        },
        "expectedSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedMtimeMs": {
          "type": "number",
          "minimum": 0
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "length": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 524288
        }
      },
      "required": [
        "type",
        "requestId",
        "attachmentId",
        "operation",
        "path"
      ],
      "additionalProperties": false
    }
  ]
}
