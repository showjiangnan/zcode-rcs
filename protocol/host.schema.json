{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "maxLength": 256
    },
    "workspaces": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "workspacePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "workspaceIdentity": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "remoteSessionId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "handle",
          "name",
          "workspacePath"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "generation",
    "name",
    "workspaces"
  ],
  "additionalProperties": false
}
